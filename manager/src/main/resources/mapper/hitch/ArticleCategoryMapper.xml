<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hitch.mapper.ArticleCategoryMapper">
    
    <resultMap type="ArticleCategory" id="ArticleCategoryResult">
        <result property="categoryId"    column="category_id"    />
        <result property="categoryName"    column="category_name"    />
        <result property="sort"    column="sort"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="ArticleCategoryArticleResult" type="ArticleCategory" extends="ArticleCategoryResult">
        <collection property="articleList" notNullColumn="sub_article_id" javaType="java.util.List" resultMap="ArticleResult" />
    </resultMap>

    <resultMap type="Article" id="ArticleResult">
        <result property="articleId"    column="sub_article_id"    />
        <result property="categoryId"    column="sub_category_id"    />
        <result property="title"    column="sub_title"    />
        <result property="content"    column="sub_content"    />
        <result property="createTime"    column="sub_create_time"    />
    </resultMap>

    <sql id="selectArticleCategoryVo">
        select category_id, category_name, sort, status, remark from t_article_category
    </sql>

    <select id="selectArticleCategoryList" parameterType="ArticleCategory" resultMap="ArticleCategoryResult">
        <include refid="selectArticleCategoryVo"/>
        <where>  
            <if test="categoryName != null  and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectArticleCategoryByCategoryId" parameterType="Long" resultMap="ArticleCategoryArticleResult">
        select a.category_id, a.category_name, a.sort, a.status, a.remark,
 b.article_id as sub_article_id, b.category_id as sub_category_id, b.title as sub_title, b.content as sub_content, b.create_time as sub_create_time
        from t_article_category a
        left join t_article b on b.category_id = a.category_id
        where a.category_id = #{categoryId}
    </select>
        
    <insert id="insertArticleCategory" parameterType="ArticleCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into t_article_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateArticleCategory" parameterType="ArticleCategory">
        update t_article_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where category_id = #{categoryId}
    </update>

    <delete id="deleteArticleCategoryByCategoryId" parameterType="Long">
        delete from t_article_category where category_id = #{categoryId}
    </delete>

    <delete id="deleteArticleCategoryByCategoryIds" parameterType="String">
        delete from t_article_category where category_id in 
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </delete>
    
    <delete id="deleteArticleByCategoryIds" parameterType="String">
        delete from t_article where category_id in 
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </delete>

    <delete id="deleteArticleByCategoryId" parameterType="Long">
        delete from t_article where category_id = #{categoryId}
    </delete>

    <insert id="batchArticle">
        insert into t_article( article_id, category_id, title, content, create_time) values
		<foreach item="item" index="index" collection="list" separator=",">
            ( #{item.articleId}, #{item.categoryId}, #{item.title}, #{item.content}, #{item.createTime})
        </foreach>
    </insert>

</mapper>